@page "/activity-logs"
@inject ActivityLogService LogService
@inject AuthService AuthService
@inject IJSRuntime JS

<PageTitle>Aktivite Logları - İzollu Dayanışma Merkezi</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudPaper Elevation="2" Class="pa-4 mb-4" Style="border-radius: 12px;">
        <MudText Typo="Typo.subtitle1" Class="mb-3" Style="font-weight: 600;">
            <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Class="mr-2" Style="font-size: 18px; vertical-align: middle;" />
            Filtreler
        </MudText>
        <MudGrid Spacing="3" Style="align-items: end;">
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker @bind-Date="_startDate" Label="Başlangıç Tarihi"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               DateFormat="dd.MM.yyyy" Editable="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker @bind-Date="_endDate" Label="Bitiş Tarihi"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               DateFormat="dd.MM.yyyy" Editable="true" />
            </MudItem>
            <MudItem xs="12" sm="6" md="@(AuthService.IsSuperAdmin ? 2 : 3)">
                <div class="form-group">
                    <label class="form-label" style="font-size: 0.75rem; margin-bottom: 2px;">İşlem Tipi</label>
                    <select id="activity-log-type-select" class="selectpicker form-control" data-live-search="false" data-width="100%"
                            @onchange="@(e => _selectedType = e.Value?.ToString() ?? "Tümü")">
                        <option value="Tümü" selected="@(_selectedType == "Tümü")">Tümü</option>
                        <option value="OgrenciEkle" selected="@(_selectedType == "OgrenciEkle")">Öğrenci Ekle</option>
                        <option value="OgrenciGuncelle" selected="@(_selectedType == "OgrenciGuncelle")">Öğrenci Güncelle</option>
                        <option value="OgrenciSil" selected="@(_selectedType == "OgrenciSil")">Öğrenci Sil</option>
                        <option value="OgrenciMezun" selected="@(_selectedType == "OgrenciMezun")">Öğrenci Mezun</option>
                        <option value="BursKesildi" selected="@(_selectedType == "BursKesildi")">Burs Kesildi</option>
                        <option value="IsAdamiEkle" selected="@(_selectedType == "IsAdamiEkle")">İş Adamı Ekle</option>
                        <option value="UyeEkle" selected="@(_selectedType == "UyeEkle")">Üye Ekle</option>
                        <option value="DonemAc" selected="@(_selectedType == "DonemAc")">Dönem Aç</option>
                    </select>
                </div>
            </MudItem>
            @if (AuthService.IsSuperAdmin)
            {
                <MudItem xs="12" sm="6" md="2">
                    <div class="form-group">
                        <label class="form-label" style="font-size: 0.75rem; margin-bottom: 2px;">Kullanıcı</label>
                        <select id="activity-log-user-select" class="selectpicker form-control" data-live-search="true" data-width="100%"
                                @onchange="@(e => _selectedUser = e.Value?.ToString() ?? "Tümü")">
                            <option value="Tümü" selected="@(_selectedUser == "Tümü")">Tümü</option>
                            @foreach (var u in _users)
                            {
                                <option value="@u" selected="@(_selectedUser == u)">@u</option>
                            }
                        </select>
                    </div>
                </MudItem>
            }
            <MudItem xs="12" sm="6" md="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="FilterLogs" FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Search"
                           Style="height: 40px;">
                    Filtrele
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudTable Items="@_logs" Dense="true" Hover="true" Loading="@_loading">
        <HeaderContent>
            <MudTh>Tarih</MudTh>
            <MudTh>Kullanıcı</MudTh>
            <MudTh>İşlem Tipi</MudTh>
            <MudTh>Detay</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Tarih">@context.Tarih.ToString("dd/MM/yyyy HH:mm:ss")</MudTd>
            <MudTd DataLabel="Kullanıcı">
                <MudChip T="string" Size="Size.Small">@context.KullaniciAdi</MudChip>
            </MudTd>
            <MudTd DataLabel="İşlem Tipi">
                <MudChip T="string" Size="Size.Small" Color="@GetChipColor(context.IslemTipi)">@context.IslemTipi</MudChip>
            </MudTd>
            <MudTd DataLabel="Detay">@context.Detay</MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@code {
    private List<ActivityLog> _logs = new();
    private List<string> _users = new();
    private bool _loading = true;
    private DateTime? _startDate;
    private DateTime? _endDate;
    private string _selectedType = "Tümü";
    private string _selectedUser = "Tümü";

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsSuperAdmin)
            _users = await LogService.GetDistinctUsersAsync();
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("bootstrapSelect.init");
            }
            catch (JSDisconnectedException)
            {
                // Component disposed, ignore
            }
        }
    }

    private async Task LoadData()
    {
        _loading = true;
        _logs = await LogService.GetAllAsync();
        _loading = false;
    }

    private async Task FilterLogs()
    {
        _loading = true;

        _logs = (_startDate != null && _endDate != null)
            ? await LogService.GetByDateRangeAsync(_startDate.Value, _endDate.Value)
            : await LogService.GetAllAsync();

        if (_selectedType != "Tümü")
            _logs = _logs.Where(l => l.IslemTipi == _selectedType).ToList();

        if (AuthService.IsSuperAdmin && _selectedUser != "Tümü")
            _logs = _logs.Where(l => l.KullaniciAdi == _selectedUser).ToList();

        _loading = false;
    }

    private Color GetChipColor(string islemTipi) => islemTipi switch
    {
        "OgrenciEkle" or "IsAdamiEkle" or "UyeEkle" or "DonemAc" => Color.Success,
        "OgrenciSil" or "IsAdamiSil" or "UyeSil" or "BursKesildi" => Color.Error,
        "OgrenciMezun" => Color.Info,
        "OgrenciGuncelle" or "IsAdamiGuncelle" or "UyeGuncelle" => Color.Warning,
        _ => Color.Default
    };
}

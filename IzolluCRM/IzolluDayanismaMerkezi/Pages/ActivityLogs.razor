@page "/activity-logs"
@using Microsoft.AspNetCore.Components.Forms
@inject ActivityLogService LogService
@inject AuthService AuthService
@inject IJSRuntime JS

<PageTitle>Aktivite Logları - İzollu Dayanışma Merkezi</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <MudCard Class="mb-4">
        <MudCardContent>
            <MudText Typo="Typo.h6" Class="mb-4">Filtreler</MudText>
            <MudGrid Spacing="3">
                <MudItem xs="12" md="3">
                    <label class="form-label"><strong>Başlangıç Tarihi</strong></label>
                    <InputDate @bind-Value="_startDate" class="form-control" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <label class="form-label"><strong>Bitiş Tarihi</strong></label>
                    <InputDate @bind-Value="_endDate" class="form-control" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudSelect T="string" @bind-Value="_selectedType" Label="İşlem Tipi" Variant="Variant.Outlined" Dense="true">
                        <MudSelectItem Value="@("Tümü")">Tümü</MudSelectItem>
                        <MudSelectItem Value="@("OgrenciEkle")">Öğrenci Ekle</MudSelectItem>
                        <MudSelectItem Value="@("OgrenciGuncelle")">Öğrenci Güncelle</MudSelectItem>
                        <MudSelectItem Value="@("OgrenciSil")">Öğrenci Sil</MudSelectItem>
                        <MudSelectItem Value="@("OgrenciMezun")">Öğrenci Mezun</MudSelectItem>
                        <MudSelectItem Value="@("BursKesildi")">Burs Kesildi</MudSelectItem>
                        <MudSelectItem Value="@("IsAdamiEkle")">İş Adamı Ekle</MudSelectItem>
                        <MudSelectItem Value="@("UyeEkle")">Üye Ekle</MudSelectItem>
                        <MudSelectItem Value="@("DonemAc")">Dönem Aç</MudSelectItem>
                    </MudSelect>
                </MudItem>
                @if (AuthService.IsSuperAdmin)
                {
                    <MudItem xs="12" md="2">
                        <MudSelect T="string" @bind-Value="_selectedUser" Label="Kullanıcı" Variant="Variant.Outlined" Dense="true">
                            <MudSelectItem Value="@("Tümü")">Tümü</MudSelectItem>
                            @foreach (var u in _users)
                            {
                                <MudSelectItem Value="@u">@u</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                }
                <MudItem xs="12" md="2" Class="d-flex align-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="FilterLogs" FullWidth="true" Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.FilterAlt">
                        Filtrele
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudCardContent>
    </MudCard>

    <MudTable Items="@_logs" Dense="true" Hover="true" Loading="@_loading">
        <HeaderContent>
            <MudTh>Tarih</MudTh>
            <MudTh>Kullanıcı</MudTh>
            <MudTh>İşlem Tipi</MudTh>
            <MudTh>Detay</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Tarih">@context.Tarih.ToString("dd/MM/yyyy HH:mm:ss")</MudTd>
            <MudTd DataLabel="Kullanıcı">
                <MudChip T="string" Size="Size.Small">@context.KullaniciAdi</MudChip>
            </MudTd>
            <MudTd DataLabel="İşlem Tipi">
                <MudChip T="string" Size="Size.Small" Color="@GetChipColor(context.IslemTipi)">@context.IslemTipi</MudChip>
            </MudTd>
            <MudTd DataLabel="Detay">@context.Detay</MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@code {
    private List<ActivityLog> _logs = new();
    private List<string> _users = new();
    private bool _loading = true;
    private DateTime? _startDate;
    private DateTime? _endDate;
    private string _selectedType = "Tümü";
    private string _selectedUser = "Tümü";

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsSuperAdmin)
            _users = await LogService.GetDistinctUsersAsync();
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _logs = await LogService.GetAllAsync();
        _loading = false;
    }

    private async Task FilterLogs()
    {
        _loading = true;

        _logs = (_startDate != null && _endDate != null)
            ? await LogService.GetByDateRangeAsync(_startDate.Value, _endDate.Value)
            : await LogService.GetAllAsync();

        if (_selectedType != "Tümü")
            _logs = _logs.Where(l => l.IslemTipi == _selectedType).ToList();

        if (AuthService.IsSuperAdmin && _selectedUser != "Tümü")
            _logs = _logs.Where(l => l.KullaniciAdi == _selectedUser).ToList();

        _loading = false;
    }

    private Color GetChipColor(string islemTipi) => islemTipi switch
    {
        "OgrenciEkle" or "IsAdamiEkle" or "UyeEkle" or "DonemAc" => Color.Success,
        "OgrenciSil" or "IsAdamiSil" or "UyeSil" or "BursKesildi" => Color.Error,
        "OgrenciMezun" => Color.Info,
        "OgrenciGuncelle" or "IsAdamiGuncelle" or "UyeGuncelle" => Color.Warning,
        _ => Color.Default
    };
}

@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace IzolluVakfi.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>İzollu Dayanışma Merkezi</title>
    <base href="~/" />
    <link rel="icon" type="image/png" href="~/izollu-vakfi.png" />
    <link rel="apple-touch-icon" href="~/izollu-vakfi.png" />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/css/bootstrap-select.min.css" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <!-- Yeniden Bağlanıyor Modal -->
    <div id="reconnect-modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:99999; align-items:center; justify-content:center; backdrop-filter:blur(3px);">
        <div style="background:white; border-radius:16px; padding:32px 28px; max-width:320px; width:90%; text-align:center; box-shadow:0 20px 60px rgba(0,0,0,0.3);">
            <div style="width:52px; height:52px; border:4px solid #f3f3f3; border-top:4px solid #f07d00; border-radius:50%; animation:spin 0.9s linear infinite; margin:0 auto 20px;"></div>
            <p style="font-size:1rem; font-weight:600; color:#1f2937; margin:0 0 6px;">Yeniden bağlanılıyor…</p>
            <p style="font-size:0.8rem; color:#6b7280; margin:0;">Lütfen bekleyin, sunucuya bağlanmaya çalışılıyor.</p>
        </div>
    </div>

    <!-- Bağlantı Başarısız Modal -->
    <div id="reconnect-failed" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.55); z-index:99999; align-items:center; justify-content:center; backdrop-filter:blur(3px);">
        <div style="background:white; border-radius:16px; padding:32px 28px; max-width:320px; width:90%; text-align:center; box-shadow:0 20px 60px rgba(0,0,0,0.3);">
            <div style="font-size:2.5rem; margin-bottom:12px;">⚠️</div>
            <p style="font-size:1rem; font-weight:600; color:#1f2937; margin:0 0 8px;">Bağlantı kesildi</p>
            <p style="font-size:0.8rem; color:#6b7280; margin:0 0 20px;">Sunucuya ulaşılamıyor. Sayfayı yenileyerek tekrar deneyin.</p>
            <button onclick="location.reload()" style="background:linear-gradient(90deg,#f07d00,#f5a93c); color:white; border:none; border-radius:999px; padding:10px 28px; font-size:0.9rem; font-weight:600; cursor:pointer; box-shadow:0 4px 12px rgba(240,125,0,0.35);">
                Sayfayı Yenile
            </button>
        </div>
    </div>

    <style>
        @@keyframes spin { to { transform: rotate(360deg); } }
    </style>

    <!-- blazor-error-ui yerine reconnect modal'lar kullanılıyor -->

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/js/bootstrap-select.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="js/bootstrap-select-init.js"></script>
    <script src="js/select2-helper.js"></script>
    <script src="js/doc-search.js"></script>
    <script src="js/responsive.js"></script>
    <script src="_framework/blazor.server.js" autostart="false"></script>
    <script>
        // Blazor reconnect ayarları
        Blazor.start({
            // 3) WebSocket koparsa long polling'e düş (mobil network için daha stabil)
            configureSignalR: function (builder) {
                builder.withAutomaticReconnect([0, 1000, 2000, 3000, 5000, 8000, 13000, 20000]);
            },
            reconnectionOptions: {
                maxRetries: 50,
                retryIntervalMilliseconds: 2500,
            },
            reconnectionHandler: {
                onConnectionDown: () => {
                    document.getElementById('reconnect-modal').style.display = 'flex';
                    document.getElementById('reconnect-failed').style.display = 'none';
                },
                onConnectionUp: () => {
                    document.getElementById('reconnect-modal').style.display = 'none';
                    document.getElementById('reconnect-failed').style.display = 'none';
                },
                onConnectionFailed: () => {
                    document.getElementById('reconnect-modal').style.display = 'none';
                    document.getElementById('reconnect-failed').style.display = 'flex';
                }
            }
        }).then(() => {
            console.log('[Blazor] başlatıldı');
        }).catch(err => {
            console.error('[Blazor] başlatma hatası:', err);
        });

        // 4) Telefon ekranı/sekme tekrar açılınca otomatik reconnect tetikle
        //    iOS Safari sekme arka plana atılınca WebSocket'i askıya alır,
        //    geri dönünce bağlantı çoğunlukla kopuk olur.
        let _reconnectInProgress = false;

        async function tryManualReconnect() {
            if (_reconnectInProgress) return;
            try {
                _reconnectInProgress = true;
                if (window.Blazor && typeof Blazor.reconnect === 'function') {
                    const ok = await Blazor.reconnect();
                    if (!ok) {
                        // Reconnect başarısız - sayfayı yenile
                        console.warn('[Blazor] reconnect false döndü, sayfa yenileniyor');
                        location.reload();
                    }
                }
            } catch (e) {
                console.warn('[Blazor] manuel reconnect hatası:', e);
            } finally {
                _reconnectInProgress = false;
            }
        }

        // Sekme/uygulama tekrar görünür olduğunda
        document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible') {
                // Reconnect modal görünüyorsa veya bağlantı yoksa tekrar dene
                const modal = document.getElementById('reconnect-modal');
                const failed = document.getElementById('reconnect-failed');
                if ((modal && modal.style.display === 'flex') ||
                    (failed && failed.style.display === 'flex')) {
                    tryManualReconnect();
                }
            }
        });

        // Network tekrar online olduğunda (örn. tüneldan çıkıldı)
        window.addEventListener('online', () => {
            console.log('[Network] tekrar online, reconnect deneniyor');
            tryManualReconnect();
        });

        // Pageshow event - bfcache'den geri dönüş (iOS Safari için kritik)
        window.addEventListener('pageshow', (evt) => {
            if (evt.persisted) {
                // Sayfa bfcache'den geldi, bağlantı kesin kopuktur
                console.log('[Blazor] bfcache restore, reconnect deneniyor');
                tryManualReconnect();
            }
        });
    </script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script>
        window.downloadFile = function (filename, base64String) {
            try {
                // Blob + createObjectURL yaklaşımı: data: URI'den farklı olarak
                // tüm tarayıcılarda ve büyük dosyalarda (~2MB+) güvenilir çalışır.
                const byteCharacters = atob(base64String);
                const byteArray = new Uint8Array(byteCharacters.length);
                for (let i = 0; i < byteCharacters.length; i++) {
                    byteArray[i] = byteCharacters.charCodeAt(i);
                }
                const blob = new Blob([byteArray], { type: 'application/octet-stream' });
                const url = URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = url;
                link.download = filename;
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                setTimeout(() => URL.revokeObjectURL(url), 5000);
            } catch (e) {
                console.error('Dosya indirme hatası:', e);
            }
        };

        window.downloadExcel = function (data, filename) {
            try {
                // JSON array'i worksheet'e çevir
                const worksheet = XLSX.utils.json_to_sheet(data);
                
                // Yeni workbook oluştur
                const workbook = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(workbook, worksheet, "Üyeler");
                
                // Excel dosyası oluştur ve indir
                XLSX.writeFile(workbook, filename);
            } catch (error) {
                console.error('Excel export error:', error);
                alert('Excel dosyası oluşturulurken hata oluştu: ' + error.message);
            }
        };
    </script>
</body>
</html>
@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject RbacService RbacService

<MudThemeProvider Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />

@if (!_sessionChecked)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Style="position:fixed;top:0;left:0;right:0;z-index:9999;" />
}
else if (AuthService.IsAuthenticated)
{
    <div class="izollu-app-shell">
        <!-- Mobil topbar (sadece mobilde görünür, CSS ile) -->
        <header class="izollu-mobile-topbar">
            <button class="hamburger-btn" type="button" onclick="window.izolluToggleSidebar()" aria-label="Menü">
                <span></span>
                <span></span>
                <span></span>
            </button>
            <img src="/izollu-vakfi.png" alt="İzollu" class="mobile-logo" />
        </header>

        <!-- Sidebar (desktop'ta sabit görünür, mobilde drawer olarak) -->
        <aside class="izollu-sidebar">
            <NavMenu OnLogout="@EventCallback.Factory.Create(this, HandleLogout)" />
        </aside>

        <!-- Mobile backdrop (sadece mobilde sidebar açıkken görünür) -->
        <div class="izollu-backdrop" onclick="window.izolluToggleSidebar()"></div>

        <!-- Ana içerik -->
        <main class="izollu-main">
            <MudContainer MaxWidth="MaxWidth.False" Class="izollu-content-container">
                @Body
            </MudContainer>
        </main>
    </div>
}
else
{
    @Body
}

@code {
    private bool _sessionChecked = false;

    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += OnAuthStateChanged;

        if (AuthService.IsAuthenticated)
            _sessionChecked = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _sessionChecked) return;

        if (!AuthService.IsAuthenticated)
        {
            await TryRestoreSessionAsync();

            if (!AuthService.IsAuthenticated)
            {
                var path = Navigation.ToBaseRelativePath(Navigation.Uri);
                if (!path.StartsWith("login"))
                {
                    Navigation.NavigateTo("/login", true);
                    return;
                }
            }
        }

        _sessionChecked = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task TryRestoreSessionAsync()
    {
        try
        {
            var stored = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "izollu_session");
            if (string.IsNullOrEmpty(stored)) return;

            var doc = System.Text.Json.JsonDocument.Parse(stored);
            if (!doc.RootElement.TryGetProperty("userId", out var userIdProp)) return;

            var user = await RbacService.GetUserByIdAsync(userIdProp.GetInt32());
            if (user != null && user.IsActive)
                AuthService.SetUser(user);
            else
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "izollu_session");
        }
        catch
        {
            try { await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "izollu_session"); } catch { }
        }
    }

    private async Task HandleLogout()
    {
        try { await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "izollu_session"); } catch { }
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= OnAuthStateChanged;
    }

    private MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#f07d00",
            PrimaryDarken = "#d46d00",
            PrimaryLighten = "#ff9933",
            Secondary = "#1E88E5",
            AppbarBackground = "#f07d00",
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#f07d00",
            PrimaryDarken = "#d46d00",
            PrimaryLighten = "#ff9933",
        }
    };
}

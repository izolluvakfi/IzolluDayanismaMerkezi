@inherits LayoutComponentBase
@implements IDisposable
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime
@inject RbacService RbacService

<MudThemeProvider Theme="_theme" />
<MudDialogProvider />
<MudSnackbarProvider />

@if (!_sessionChecked)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Style="position:fixed;top:0;left:0;right:0;z-index:9999;" />
}
else if (AuthService.IsAuthenticated)
{
    <MudLayout Class="app-layout">
        <!-- MOBILE BACKDROP -->
        @if (_drawerOpen && _isMobile)
        {
            <div class="mobile-backdrop" @onclick="ToggleDrawer"></div>
        }

        <MudDrawer @bind-Open="@_drawerOpen"
                   ClipMode="DrawerClipMode.Always"
                   Elevation="2"
                   Variant="@(_isMobile ? DrawerVariant.Temporary : DrawerVariant.Persistent)"
                   Class="sidebar app-drawer">
            <NavMenu OnLogout="@EventCallback.Factory.Create(this, HandleLogout)" />
        </MudDrawer>
        <MudMainContent Class="page-content">
            <!-- MOBILE HAMBURGER BAR -->
            @if (_isMobile)
            {
                <div class="mobile-topbar">
                    <button class="hamburger-btn" @onclick="ToggleDrawer" aria-label="Menü">
                        <span></span>
                        <span></span>
                        <span></span>
                    </button>
                    <img src="/izollu-vakfi.png" alt="İzollu" class="mobile-logo" />
                </div>
            }
            <MudContainer MaxWidth="MaxWidth.False" Class="@(_isMobile ? "mt-2" : "mt-4")">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}
else
{
    @Body
}

@code {
    private bool _sessionChecked = false;
    private bool _drawerOpen = true;
    private bool _isMobile = false;
    private DotNetObjectReference<AuthorizedLayout>? _dotNetRef;

    protected override void OnInitialized()
    {
        AuthService.OnAuthStateChanged += OnAuthStateChanged;

        // Eğer kullanıcı zaten authenticated ise (login'den yeni geldi),
        // session check'i atla → login sonrası beyaz ekran flash'ı önlenir.
        if (AuthService.IsAuthenticated)
            _sessionChecked = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Mobil ekran tespiti + resize listener kaydı
            try
            {
                _isMobile = await JSRuntime.InvokeAsync<bool>("isMobileScreen");
                _drawerOpen = !_isMobile;
                _dotNetRef = DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync("registerResizeCallback", _dotNetRef);
                await InvokeAsync(StateHasChanged);
            }
            catch
            {
                // JS yüklenmemişse sessizce geç
            }
        }

        if (!firstRender || _sessionChecked) return;

        // Reload durumu — localStorage'dan session'ı geri yükle
        if (!AuthService.IsAuthenticated)
        {
            await TryRestoreSessionAsync();

            if (!AuthService.IsAuthenticated)
            {
                var path = Navigation.ToBaseRelativePath(Navigation.Uri);
                if (!path.StartsWith("login"))
                {
                    Navigation.NavigateTo("/login", true);
                    return;
                }
            }
        }

        _sessionChecked = true;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnScreenResize(bool isMobile)
    {
        if (_isMobile == isMobile) return;
        _isMobile = isMobile;
        _drawerOpen = !isMobile;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task TryRestoreSessionAsync()
    {
        try
        {
            var stored = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", "izollu_session");
            if (string.IsNullOrEmpty(stored)) return;

            var doc = System.Text.Json.JsonDocument.Parse(stored);
            if (!doc.RootElement.TryGetProperty("userId", out var userIdProp)) return;

            var user = await RbacService.GetUserByIdAsync(userIdProp.GetInt32());
            if (user != null && user.IsActive)
                AuthService.SetUser(user);
            else
                await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "izollu_session");
        }
        catch
        {
            try { await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "izollu_session"); } catch { }
        }
    }

    private async Task HandleLogout()
    {
        try { await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "izollu_session"); } catch { }
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    private void OnAuthStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        AuthService.OnAuthStateChanged -= OnAuthStateChanged;
        _dotNetRef?.Dispose();
    }

    private MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#f07d00",
            PrimaryDarken = "#d46d00",
            PrimaryLighten = "#ff9933",
            Secondary = "#1E88E5",
            AppbarBackground = "#f07d00",
        },
        PaletteDark = new PaletteDark()
        {
            Primary = "#f07d00",
            PrimaryDarken = "#d46d00",
            PrimaryLighten = "#ff9933",
        }
    };
}

@inject AuthService AuthService

<div class="izollu-nav-menu sidebar">
    <!-- Logo Section -->
    <div class="nav-header logo-container drawer-logo" style="margin-bottom: 10px;">
        <img src="/izollu-vakfi.png" alt="İzollu Dayanışma Merkezi" class="nav-logo" />
    </div>

    <!-- Kullanıcı Bilgisi -->
    <div class="user-info-section">
        <div class="user-avatar">
            <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Style="font-size: 28px; color: #f59e0b;" />
        </div>
        <div class="user-details">
            <MudText Typo="Typo.body2" Style="font-weight: 600; color: #374151; font-size: 0.8rem;">@AuthService.DisplayName</MudText>
            <MudChip T="string" Size="Size.Small" Color="@GetRoleChipColor()" Variant="Variant.Filled" Style="height: 18px; font-size: 0.65rem; margin-top: 2px;">
                @AuthService.GetRoleDisplayName()
            </MudChip>
        </div>
    </div>

    <!-- ANA MENÜ -->
    <div class="nav-section-title menu-title">ANA MENÜ</div>

    <MudNavMenu Dense="true" Class="nav-menu">
        <MudNavLink Href="/reports"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Filled.Dashboard"
                    Class="nav-item menu-item"
                    ActiveClass="nav-item-active">
            Dashboard
        </MudNavLink>
    </MudNavMenu>

    <!-- İŞLEMLER -->
    <div class="nav-section-title menu-title">İŞLEMLER</div>

    <MudNavMenu Dense="true" Class="nav-menu">
        <MudNavLink Href="/students"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Filled.School"
                    Class="nav-item menu-item"
                    ActiveClass="nav-item-active">
            Öğrenciler
        </MudNavLink>

        <MudNavLink Href="/members"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Filled.People"
                    Class="nav-item menu-item"
                    ActiveClass="nav-item-active">
            Üyeler
        </MudNavLink>

        <MudNavLink Href="/villages"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Filled.LocationCity"
                    Class="nav-item menu-item"
                    ActiveClass="nav-item-active">
            Köyler
        </MudNavLink>

        <MudNavLink Href="/aids"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Filled.VolunteerActivism"
                    Class="nav-item menu-item"
                    ActiveClass="nav-item-active">
            Yardımlar
        </MudNavLink>

        <MudNavLink Href="/meetings"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Filled.Event"
                    Class="nav-item menu-item"
                    ActiveClass="nav-item-active">
            Toplantılar
        </MudNavLink>
    </MudNavMenu>

    <!-- SİSTEM - Admin ve SuperAdmin -->
    @if (AuthService.HasPermission(Permissions.Settings))
    {
        <div class="nav-section-title menu-title">SİSTEM</div>

        <MudNavMenu Dense="true" Class="nav-menu">
            <MudNavLink Href="/excel-import"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.UploadFile"
                        Class="nav-item menu-item"
                        ActiveClass="nav-item-active">
                Excel İçe Aktar
            </MudNavLink>

            <MudNavLink Href="/activity-logs"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.History"
                        Class="nav-item menu-item"
                        ActiveClass="nav-item-active">
                Aktivite Logları
            </MudNavLink>

            <MudNavLink Href="/settings"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.Settings"
                        Class="nav-item menu-item"
                        ActiveClass="nav-item-active">
                Ayarlar
            </MudNavLink>
        </MudNavMenu>
    }

    <!-- YÖNETİM - Sadece SuperAdmin -->
    @if (AuthService.HasPermission(Permissions.UserManagement))
    {
        <div class="nav-section-title menu-title" Style="color: #ef4444;">YÖNETİM</div>

        <MudNavMenu Dense="true" Class="nav-menu">
            <MudNavLink Href="/admin/users"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Filled.ManageAccounts"
                        Class="nav-item menu-item admin-item"
                        ActiveClass="nav-item-active">
                Kullanıcı & Rol Yönetimi
            </MudNavLink>
        </MudNavMenu>
    }

    <!-- Footer Section -->
    <div class="nav-footer logout-section">
        <div class="nav-footer-link logout-link menu-item" @onclick="HandleLogoutClick">
            <MudIcon Icon="@Icons.Material.Filled.Logout" />
            <span>Çıkış Yap</span>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public EventCallback OnLogout { get; set; }

    private async Task HandleLogoutClick()
    {
        await OnLogout.InvokeAsync();
    }

    private Color GetRoleChipColor() => AuthService.Role switch
    {
        IzolluVakfi.Data.Enums.UserRole.SuperAdmin => Color.Error,
        IzolluVakfi.Data.Enums.UserRole.Admin => Color.Primary,
        IzolluVakfi.Data.Enums.UserRole.ReadOnly => Color.Success,
        _ => Color.Default
    };
}

<style>
    .izollu-nav-menu {
        display: flex;
        flex-direction: column;
        height: 100vh;
        background: #ffffff;
        margin: 0;
        padding: 0;
        padding-bottom: 60px;
        position: relative;
        box-sizing: border-box;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .nav-header {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100px;
        padding: 10px 16px;
        border-bottom: 1px solid #f1f5f9;
        margin-bottom: 8px;
        flex-shrink: 0;
        background: transparent;
    }

    .nav-logo {
        max-width: 240px;
        max-height: 132px;
        width: auto;
        height: auto;
        object-fit: contain;
        display: block;
        margin: 0 auto;
        transition: transform 0.2s ease, opacity 0.2s ease;
    }

    .nav-logo:hover {
        transform: scale(1.03);
        opacity: 0.9;
        cursor: pointer;
    }

    .user-info-section {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        margin: 4px 8px 8px 8px;
        background: #fef9f0;
        border-radius: 12px;
        border: 1px solid #fde68a;
        flex-shrink: 0;
    }

    .user-avatar {
        flex-shrink: 0;
    }

    .user-details {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .nav-section-title {
        font-size: 0.65rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #9ca3af;
        margin: 12px 0 6px 0.5rem;
        font-weight: 600;
        flex-shrink: 0;
    }

    .nav-menu {
        padding: 0 0.5rem 0;
        overflow: hidden;
        flex: 0 0 auto;
    }

    .nav-item,
    .nav-item a,
    .izollu-nav-menu a,
    .izollu-nav-menu .mud-nav-link,
    .mud-nav-link {
        border-radius: 999px !important;
        margin: 1px 2px !important;
        padding: 10px 14px !important;
        color: #4b5563;
        transition: all 0.2s ease;
        font-size: 0.85rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        text-decoration: none !important;
    }

    .izollu-nav-menu a:hover,
    .izollu-nav-menu a:focus,
    .izollu-nav-menu a:active,
    .mud-nav-link:hover,
    .mud-nav-link:focus,
    .mud-nav-link:active {
        text-decoration: none !important;
    }

    .nav-item .mud-icon-root {
        font-size: 18px;
        margin-right: 0.35rem;
        color: #6b7280;
        flex-shrink: 0;
    }

    .nav-item:hover {
        background: #fef3c7 !important;
        color: #f59e0b;
        transform: translateX(4px);
    }

    .nav-item:hover .mud-icon-root {
        color: #f59e0b;
    }

    .nav-item-active {
        background: linear-gradient(90deg, #ef9420, #f5a93c) !important;
        color: white !important;
        font-weight: 600;
        box-shadow: 0 4px 12px rgba(239, 148, 32, 0.3);
    }

    .nav-item-active .mud-icon-root {
        color: white !important;
    }

    .admin-item .mud-icon-root {
        color: #ef4444 !important;
    }

    .admin-item:hover {
        background: #fee2e2 !important;
        color: #ef4444 !important;
    }

    .nav-footer {
        width: 100%;
        padding: 0.5rem;
        border-top: 1px solid #e2e8f0;
        background: linear-gradient(180deg, #f1f5f9 0%, #e2e8f0 100%);
        margin-top: auto;
    }

    .nav-footer-link {
        border-radius: 999px !important;
        margin: 2px 2px !important;
        padding: 8px 10px !important;
        font-size: 0.85rem;
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        cursor: pointer;
        color: #4b5563;
        white-space: nowrap;
    }

    .nav-footer-link .mud-icon-root {
        font-size: 18px;
        margin-right: 0.5rem;
        color: #6b7280;
        flex-shrink: 0;
    }

    .nav-footer-link:hover {
        background: #f3f4f6 !important;
        transform: translateX(4px);
    }

    .logout-link {
        color: #ef4444 !important;
        font-weight: 500;
    }

    .logout-link:hover {
        background: #fee2e2 !important;
    }

    .logout-link .mud-icon-root {
        color: #ef4444 !important;
    }

    @@media (max-width: 768px) {
        .nav-header { height: 120px; padding: 10px 12px; }
        .nav-logo { max-width: 170px; max-height: 95px; }
    }

    @@media (max-width: 480px) {
        .nav-header { height: 100px; padding: 8px 8px; }
        .nav-logo { max-width: 140px; max-height: 80px; }
    }
</style>
